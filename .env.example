# Copy to .env.local and fill in values. Never commit real secrets.

# Public URL of the app (used for links in emails, PDFs, redirects).
# On Vercel this falls back to the deployment URL, so only set it there
# once you have a custom domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Postgres. On Vercel these are injected by the Neon integration.
# Locally, copy them from the Neon console (use the `dev` branch).
# Pooled connection, for the app:
DATABASE_URL=
# Direct connection, for migrations:
DATABASE_URL_UNPOOLED=

# Signs sessions and tokens. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google sign-in (optional until the OAuth client exists).
# Redirect URI: <app url>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel only: lets previews use Google sign-in through the production callback.
# Same value in Production and Preview. Generate with: openssl rand -base64 32
# OAUTH_PROXY_SECRET=

# Vercel Blob, for business logos (optional; upload is off without it).
# Added by connecting the store; locally, get it with `vercel env pull`.
# BLOB_READ_WRITE_TOKEN=

# Resend, for verification and password reset emails (optional; both are
# off without it). EMAIL_FROM must use a domain verified in Resend.
# RESEND_API_KEY=
# EMAIL_FROM=Invoicely <hello@yourdomain.com>

# Sentry, for errors, traces and replays (optional; off without the DSN).
# NEXT_PUBLIC_SENTRY_DSN=
# Build time only, uploads source maps. Create an org token in Sentry under
# Settings > Auth Tokens. Set it on Vercel, not locally.
# SENTRY_AUTH_TOKEN=

# Set to 1 to build without validating env vars (e.g. Docker image builds).
# SKIP_ENV_VALIDATION=1
